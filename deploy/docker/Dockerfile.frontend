# ============================================================
# metric-code 前端容器化构建（Nginx + 静态文件）
#   - 仅包含前端构建产物 + Nginx 反向代理配置
#   - 与后端镜像分离，独立部署/更新
#
# 用法:
#   cd frontend && npm run build   # 先构建前端
#   docker build -f deploy/docker/Dockerfile.frontend -t metric-frontend:latest .
# ============================================================

FROM docker.1ms.run/library/nginx:alpine

# 时区
RUN apk add --no-cache tzdata vim && \
    ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

# Nginx 配置
COPY deploy/nginx/metric-code.conf /etc/nginx/conf.d/default.conf

# 前端构建产物
COPY frontend/dist /usr/share/nginx/html/metric-code

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://localhost/metric-code/ || exit 1
