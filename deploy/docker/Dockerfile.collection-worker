ARG PYTHON_IMAGE=python:3.12-slim
FROM ${PYTHON_IMAGE}
WORKDIR /opt/collection-worker
# Default runtime uses the standard library only. No pip/network dependency installation.
# For XLSX, prebuild the optional offline image with Dockerfile.collection-worker.xlsx.
COPY backend/collection-python/worker.py ./worker.py
ENV TZ=Asia/Shanghai PYTHONUNBUFFERED=1
ENTRYPOINT ["python", "-X", "utf8", "/opt/collection-worker/worker.py", "--files-root", "/app/files"]
