# Copy to .env.worker.local (ignored). Do not place datasource credentials here.
# Must match backend COLLECTION_WORKER_TOKEN; generate a random token of 32+ characters.
COLLECTION_WORKER_TOKEN=replace-with-random-service-token-at-least-32-characters
COLLECTION_WORKER_API=http://127.0.0.1:18080
COLLECTION_WORKER_ID=local-worker
# Must equal the effective platform upload.base_path and refer to the shared files volume.
COLLECTION_WORKER_FILES_ROOT=D:/metric-data/files
# Optional Python interpreter/venv containing the plugin requirements.
# COLLECTION_WORKER_PYTHON=D:/metric-python/Scripts/python.exe

# Optional secondary storage for an explicit source-code whitelist. Set the same values on backend and Worker.
COLLECTION_EXTERNAL_FILES_ROOT=
COLLECTION_EXTERNAL_SOURCE_CODES=

# Optional direct JDBC/BPM acquisition for production CSV tasks (server only).
# Directory must contain internal_staff.json and running_efficiency.json.
# Copy categories/<code>/connections.example.json and configure secrets outside Git.
# Requires offline-installed JPype1/JayDeBeApi and a JVM/JDBC jars on that Worker host.
# COLLECTION_SOURCE_CONNECTIONS_ROOT=/etc/metric-collection/sources
