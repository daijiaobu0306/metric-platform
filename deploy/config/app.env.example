# ============================================================
# metric-code 非容器化部署 —— 运行配置模板
#
# 用法：
#   cp config/app.env.example config/app.env
#   chmod 600 config/app.env
#   vi config/app.env          # 把 <> 占位符全部改成真实值
#
# 说明：
#   - app.env 含明文口令，权限 600，不要提交 Git、不要外传。
#   - 脚本会拒绝含 <...> 的占位符和 change-me 弱口令，改完再执行。
#   - 2026-11-21 起数据库与平台同机（67），只需一份 app.env；原 66 数据库机已下线。
# ============================================================

# ---- 后端端口（67）独立端口，不占用生产既有 18080 ----
APP_PORT=18090

# ---- 对外唯一代理端口（67）----
# 前端页面 /metric-code/ 与后端 API /metric-code/api/ 都走这一个端口，
# 由 67 上的 nginx 统一代理（已有 nginx 就复用，没有就编译独立实例）。
# 8080 优先；18080 已被生产既有后端占用，不要用。
NGINX_PORT=8080

# ---- 独立实例 nginx 装到哪（67，可选）----
# 不填 = 包目录下 lib/nginx（当前用户可写，全程不需要 sudo）。
# 只有要把 nginx 装到别处（如已装在 /opt）时才填绝对路径。
# NGINX_PREFIX=/opt/metric-code-standalone/nginx

# ---- 前端静态目录（67，可选）----
# 不填则用包内 frontend/（推荐，随包升级）。
# 只有要把前端放到别的路径时才填绝对路径。
# FRONTEND_ROOT=/opt/metric-code-standalone/frontend

# ---- 数据库（必须是显式 jdbc:mysql URL）----
# 脚本靠它解析主机/端口/库名，缺端口时默认 3306。
# 2026-11-21 拓扑：数据库与平台同机部署在 67，库地址用本机 127.0.0.1；原 66 数据库机已停用下线。
DB_URL=jdbc:mysql://127.0.0.1:3306/system_operations_metrics?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
# 同机可只给本机账号；若数据库仍在其他主机，按其实际地址填写并收紧权限，脚本无需改
DB_USER=root
DB_PASSWORD=RealPass12345

# ---- JDK（初始化数据库和运行后端都需要 17+）----
# 系统默认 JDK8，本应用必须 17+；脚本会校验版本，不符直接报错退出。
# 67 上的路径为 /home/appuser/besinsight/component/
JAVA_HOME=/home/appuser/besinsight/component/jdk17

# ---- JVM 参数（67）----
JAVA_OPTS=-Xms512m -Xmx2g -XX:+UseG1GC

# ---- MySQL 客户端路径（可选）----
# 67 上客户端与服务端同为 8.0，位于 /home/appuser/besinsight/component/ 下。
# 脚本自动定位顺序：本项 → PATH → 常见目录（含 component/mysql*/bin、component/mysql/bin）
#                  → 全盘 find 兜底。所以一般不用填；只有自动找错时才显式指定。
# MYSQL_BIN=/home/appuser/besinsight/component/mysql/bin/mysql
# MYSQLDUMP_BIN=/home/appuser/besinsight/component/mysql/bin/mysqldump

# ---- 跨域白名单（67，经代理/多域名访问时必填）----
# 浏览器提交 Origin，后端只认列在这里的来源；不匹配会直接 403 "Invalid CORS request"，
# 页面表现是「登录页能打开，但一登录就提示用户名或密码错误」。
# 填浏览器地址栏里那个地址（协议+主机+端口），多个用逗号分隔，结尾不要加斜杠。
# 走 nginx 同源部署且没换域名时通常不用填；加了一层/两层代理或换域名就要填。
# APP_CORS_ALLOWED_ORIGINS=http://192.168.1.11,http://metric.example.com

# ---- 采集执行器令牌（67，可选；由 bin/install-worker.sh 自动生成）----
# 后端校验规则：令牌长度 <32 一律 401，采集任务会永远停在「等待执行器」。
# 手动填也可以，但两端（后端 env / Worker env）必须完全一致。
# COLLECTION_WORKER_TOKEN=

# ---- 统一认证（67，可选）----
# ！！不接 SSO 就保持以下各行【注释状态】，千万不要写成 SSO_OIDC_CLIENT_ID= 这样的空值。
#    Spring 的 ${X:默认值} 只在变量「不存在」时才用默认值；变量存在但为空串会覆盖掉默认值，
#    启动时直接失败：Client id must not be empty.
#    接 SSO 时再把需要的行取消注释并填真实值。
# SSO_OIDC_CLIENT_ID=
# SSO_OIDC_CLIENT_SECRET=
# SSO_AUTH_URI=
# SSO_TOKEN_URI=
# SSO_JWKS_URI=
# SSO_USERINFO_URI=
# SSO_OIDC_SCOPE=
# SSO_USERMANAGER_URL=
# SSO_USERMANAGER_BROWSER_URL=
# SSO_JWT_SECRET=
# SSO_FRONTEND_BASE_URL=      # 唯一允许留空的一项：同源走 nginx 反代，留空表示用相对路径
SSO_SYNC_ENABLED=false
