# ============================================================
# 云 staging 环境变量模板
#
# 使用：
#   1. cp .env.staging.example /opt/metric-staging/.env.staging
#   2. 替换所有 <...> 占位符
#   3. 确保 .env.staging 不提交到 git（已在 .gitignore 里）
#
# 端口：staging 用 18081（后端）+ 28081（nginx）+ 28082（webhook）
#       不与本地 dev 18080/28080 冲突
# ============================================================

# 镜像 tag（每次部署由 webhook-deploy.sh 自动更新）
VERSION=staging-latest

# 数据库（云服务器 host MySQL，3306 已在用；容器通过 host.docker.internal:3306 访问）
SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/system_operations_metrics_staging?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
# 复用云服务器已有的 um_app（不要新建 metric_staging）
SPRING_DATASOURCE_USERNAME=um_app
SPRING_DATASOURCE_PASSWORD=<replace-with-strong-password>

# SSO（指向云服务器 7200 上已跑的 usermanager 容器）
SSO_USERMANAGER_URL=http://host.docker.internal:7200/usermanager
SSO_USERMANAGER_BROWSER_URL=http://8.148.195.209:7200/usermanager
# 必须与 application.yml 占位变量名 SSO_OIDC_* 对齐（容器启动期绑定到 Spring OAuth2 client）
SSO_OIDC_CLIENT_ID=metric-code
SSO_OIDC_CLIENT_SECRET=<replace-or-blank>

# 前端 base URL（云 staging 公网访问入口）
SSO_FRONTEND_BASE_URL=http://8.148.195.209:28081/metric-code

# JWT 签名密钥（必须 ≥32 字节；用 openssl rand -base64 48 生成）
SSO_JWT_SECRET=<openssl rand -base64 48 生成的字符串>

# Gitee Webhook 配置（webhook-deploy.sh 用）
GITEE_WEBHOOK_SECRET=<replace-with-strong-secret>
GITEE_BRANCH=main
DEPLOY_REPO_DIR=/opt/metric-staging
LOG_DIR=/opt/metric-staging/logs

# 智云 Common 签名密钥：由双方约定，实际值仅填本机/部署环境，不提交
STARAGENT_COMMON_AUTH_SECRET=
