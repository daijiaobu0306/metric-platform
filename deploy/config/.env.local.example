# Copy to deploy/config/.env.local, fill local paths/passwords, and never commit the copy.
# JDK 17+ and Maven/npm/mysql/mysqldump must be available on PATH.
JAVA_HOME=C:/Program Files/Java/jdk-17
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/system_operations_metrics?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me-database-password
SERVER_PORT=18080
# Set an absolute writable directory on your own machine. No source-machine drive letters are seeded.
UPLOAD_BASE_PATH=D:/metric-data/files
SCRIPT_STORAGE_PATH=D:/metric-data/files/scripts
MOCKDATA_EXTERNAL_ENABLED=true
MOCKDATA_SATISFACTION_ENABLED=true
# Local machines do not automatically connect to the team's internal BOMC service.
BOMC_ENABLED=false
# Used only by fresh initialization and the optional demo-data tool; not required by normal startup.
METRIC_ADMIN_USERNAME=admin
METRIC_ADMIN_PASSWORD=change-me-admin-password

# Optional independent collection Worker. Generate a random 32+ character token; match .env.worker.local.
# COLLECTION_WORKER_TOKEN=

# Optional secondary storage for an explicit source-code whitelist. Set the same values on backend and Worker.
COLLECTION_EXTERNAL_FILES_ROOT=
COLLECTION_EXTERNAL_SOURCE_CODES=

# 智云 Common 签名密钥：由双方约定，实际值仅填本机/部署环境，不提交
STARAGENT_COMMON_AUTH_SECRET=
