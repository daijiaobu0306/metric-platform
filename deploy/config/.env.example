# ============================================================
# metric-code 部署环境变量模板
#   - 复制为 .env 后按实际环境填写
#   - .env 文件不要提交到 Git
# ============================================================

# ---- 应用版本 ----
# 对应 docker save 出来的镜像 tag，由 docker-build.sh 生成
VERSION=latest

# ---- 服务端口 ----
# 默认 18080，如需改为别的端口（避免冲突）改这里
APP_PORT=18080

# ---- 数据库连接 ----
# 容器内访问宿主机 MySQL 用 host.docker.internal:3306（已在 compose 配置 extra_hosts）
# 容器内访问其他服务器的 MySQL 直接写 IP 或域名
DB_URL=jdbc:mysql://host.docker.internal:3306/system_operations_metrics?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASSWORD=your_password_here
# 与 DB_URL 中的实际库名一致；容器自动升级会核对目标库。
DB_NAME=system_operations_metrics

# ---- 宿主机持久化目录 ----
# 按实际服务器路径填写
# 示例:
#   生产服务器 /home/appuser/metric-code2/files
#   本地 Mac    /Users/developer/metric_code/files
HOST_FILES_PATH=/home/appuser/metric-code2/files
HOST_LOGS_PATH=/home/appuser/metric-code2/logs

# ---- JVM 参数（可选） ----
# 默认: -Xms512m -Xmx2g -XX:+UseG1GC
# 内存大可以调高 -Xmx；内存小服务器调低
# JAVA_OPTS=-Xms1g -Xmx4g -XX:+UseG1GC

# ---- appuser-agent 监控探针（生产推荐启用） ----
# Dockerfile 已把 appuser-agent 目录 COPY 到镜像内 /opt/appuser-agent
#   - APPUSER_AGENT_HOME：镜像内 agent 安装根目录，通常无需修改
#   - APPUSER_AGENT_NAME：当前应用实例名，会拼接到 instance.home 路径末尾
#   - HOST_APPUSER_AGENT_PATH：宿主机持久化目录，存放 agentInfo 运行数据，重启不丢失
APPUSER_AGENT_HOME=/opt/appuser-agent
APPUSER_AGENT_NAME=mop
HOST_APPUSER_AGENT_PATH=/home/appuser/metric-code2/appuser-agent-runtime

# 智云 Common 签名密钥：由双方约定，实际值仅填本机/部署环境，不提交
STARAGENT_COMMON_AUTH_SECRET=
