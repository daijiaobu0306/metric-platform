# ============================================================
# metric-code 生产环境变量配置
#   - 复制为 .env 后按实际环境填写
#   - .env 文件不要提交到 Git
# ============================================================

# ---- 版本号（默认日期格式 v2026.06.17，构建时自动覆盖） ----
VERSION=latest

# ---- 前端端口 ----
FRONTEND_PORT=80

# ---- 数据库连接（指向生产 MySQL 主机） ----
DB_URL=jdbc:mysql://192.168.1.100:3306/system_operations_metrics?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=system_operations_metrics

# ---- 宿主机持久化目录 ----
HOST_FILES_PATH=/home/deploy/metric-code/files
HOST_LOGS_PATH=/home/deploy/metric-code/logs

# ---- JVM 参数 ----
JAVA_OPTS=-Xms512m -Xmx2g -XX:+UseG1GC

# ---- appuser-agent 监控探针 ----
# APPUSER_AGENT_HOME：镜像内 agent 安装根目录，Dockerfile 已 COPY 到 /opt/appuser-agent
# APPUSER_AGENT_NAME：当前应用实例名，最终拼接到 instance.home 路径末尾（agentInfo/<name>）
# HOST_APPUSER_AGENT_PATH：宿主机持久化目录，存放 agentInfo 运行数据，重启不丢失
APPUSER_AGENT_HOME=/opt/appuser-agent
APPUSER_AGENT_NAME=mop
HOST_APPUSER_AGENT_PATH=/home/deploy/metric-code/appuser-agent-runtime

# ============================================================
# 统一认证客户端（启动期绑定，必须 docker compose restart backend 后生效）
# 真实值由 usermanager 运维提供；先按下方猜测值上线，后续按 §access-link 走通后调
# ============================================================
SSO_OIDC_CLIENT_ID=metric-code
SSO_OIDC_CLIENT_SECRET=<fill-from-usermanager-ops>
SSO_OIDC_SCOPE=

# 4 个端点（先按 dev mock IdP 风格拼，path 不对的话改成你们 usermanager 实际路径）
SSO_AUTH_URI=http://appuser.sn.cmcc/usermanager/oauth/authorize
SSO_TOKEN_URI=http://appuser.sn.cmcc/usermanager/oauth/token
SSO_JWKS_URI=http://appuser.sn.cmcc/usermanager/.well-known/jwks.json
SSO_USERINFO_URI=http://appuser.sn.cmcc/usermanager/user/me

# 前端跳转拼接：留空让 Oauth2LoginSuccessHandler 走 nginx 同源
SSO_FRONTEND_BASE_URL=
SSO_FRONTEND_CALLBACK_PATH=/metric-code/sso/callback
SSO_FRONTEND_LOGIN_PATH=/metric-code/login
SSO_DEFAULT_TARGET=/metric-code/

# 定时同步（如要自动从 IdP 拉用户/角色，再开启；需要 IdP 提供查询 API）
SSO_SYNC_ENABLED=false
SSO_SYNC_DELAY_MS=3600000
SSO_SYNC_API_BASE_URL=
SSO_SYNC_API_TOKEN=
